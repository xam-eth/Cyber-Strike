# Python tooling
.venv/
venv/
__pycache__/
*.py[cod]

# glTF tooling dependencies
node_modules/
tools/gltf/node_modules/
tools/gltf/build/

# Standalone Godot character QA caches/imports
.godot/
**/.godot/
# Character Visual QA uses local staged copies of GLBs; source files remain in
# game/assets or source-assets and are copied by character_visual_qa/tools/sync_assets.py.
character_visual_qa/assets/*
!character_visual_qa/assets/.gitkeep
character_visual_qa/staged_assets.json
.import/
*.import
*.uid

# The QA desk stages local copies from the source/runtime asset folders.
character_visual_qa/assets/*
!character_visual_qa/assets/.gitkeep
character_visual_qa/staged_assets.json

# Local/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.log
