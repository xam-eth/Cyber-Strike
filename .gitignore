# Local tools, Python lint environment/cache (do not commit)
.cache/
tools/.cache/
tools/node_modules/
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Godot generated/imported cache (do not commit)
.godot/
**/.godot/
.import/
# Godot writes most of these next to each asset; they are regenerated by the
# headless import step and stay out of git. Frontier Signal is the deliberate
# exception: its five small import files are source settings that disable QOA so
# the existing runtime/headless contract remains stereo 16-bit PCM.
*.import
!game/assets/audio/*.wav.import
# The glTF importer extracts embedded textures next to the .glb. They come from
# the same import step as the .import files, so they are regenerated too.
game/assets/**/hero_HERO_3d_model_*.jpg
game/assets/**/rifle_futuristic+gun+3d+model_*.jpg
# Same for the uploaded SciFi kit: the GLB carry their textures, and the
# importer writes an extracted copy next to each model.
game/assets/world/scifi_starter_kit/models/*.jpg
# The real-world forge has the same embedded-texture import behavior. These
# extracted copies are reproducible; the GLBs and staged runtime world stay tracked.
game/assets/forge/world/world_*.jpg
game/assets/forge/worlds/*_*.jpg
game/assets/world/real/**/*.png
game/assets/world/real/**/*.jpg
# Godot 4.6+ writes one .uid next to every script. This project references
# scripts by res:// path everywhere, so the files are regenerated on import and
# never need to be tracked.
*.uid
export.cfg
export_presets.cfg
**/export.cfg
**/export_presets.cfg

# Android/Gradle local and generated files
.gradle/
**/.gradle/
local.properties
**/local.properties
build/
**/build/

# The exported web payload under web/ is committed on purpose: the served site
# needs it, and a clone plus "python -m http.server 800" must play the game with
# no artifact download. The web-preview CI job refreshes it. Same layout idea as
# xam-eth/Scary-Night, which keeps its engine and web export templates in-tree.

# Local exports and packages
exports/
export/
*.apk
*.aab
*.keystore
*.jks
*.p12

# Secrets and local environment files
.env
.env.*
!.env.example

# Blender backup/recovery files (keep .blend source files)
*.blend1
*.blend2
*.blend@*
*.autosave.blend

# Operating-system/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.log

# 3D asset forge: rendered evidence and exported GLBs are build products. The
# committed record is tools/asset-forge/results.json plus review/ contact sheets.
tools/asset-forge/build/

# Agent/sandbox configuration, never part of the branch
.claude/
