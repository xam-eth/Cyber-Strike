; Engine configuration file.
; EXOCONFLICT: STELLAR HORIZON - HERO_01 standalone rig-validation project.
; Target: Godot 4.7.2 (GDScript only, no addons).

config_version=5

[application]

config/name="EXOCONFLICT_HERO01_RigValidation"
config/description="Standalone HERO_01 rig, weapon-attachment and Weapon_Raise_To_Aim validation project."
run/main_scene="res://scenes/main/RigValidation.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
; Validation-project quality: MSAA 8x (3) + anisotropic filtering 16x (4).
; Host-game projects should choose their own performance budget.
anti_aliasing/quality/msaa_3d=3
textures/default_filters/anisotropic_filtering_level=4
