.godot/
*.import
# Intentionally tracked: force lossless (Embed as Uncompressed) texture import for the 4K hero/weapon GLBs.
!assets/characters/HERO_01_RIGGED.glb.import
!assets/weapons/HERO_01_WEAPON.glb.import
export_presets.cfg
# Extracted glTF textures: regenerated by Godot on import; canonical copies live inside the GLBs.
assets/characters/*_combat_armor_3d_model_*.jpg
assets/characters/*_combat_armor_3d_model_*.png
assets/weapons/*_futuristic_exosuit_3d_model_*.jpg
assets/weapons/*_futuristic_exosuit_3d_model_*.png
