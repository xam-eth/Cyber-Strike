[resource]
script = ExtResource("1_definition")
world_id = &"verdant_bloom"
display_name = "Verdant Bloom"
role_description = "STELLAR HORIZON — Recovery. Enter an overgrown bio-research station, recover the Seed Vault blueprint and search the crashed laboratory modules before the security detail closes in."
world_scene = ExtResource("2_world")
environment_scene_path = "res://assets/forge/worlds/verdant.glb"
field_size = Vector2(188, 176)
field_center = Vector2(0, -6)
plate_path = "res://assets/ui/world_verdant_bloom.jpg"
status_line = "OPEN"
zone_title = "EXPLORE THE BLOOM"
zone_subtitle = "RECOVERY · SEED VAULT SIGNAL"
field_ready = true
player_spawn = Vector3(0, 0.1, 12)
recovery_caches = Array[RecoveryCacheDefinition]([SubResource("Resource_seed_vault"), SubResource("Resource_crashed_lab")])
