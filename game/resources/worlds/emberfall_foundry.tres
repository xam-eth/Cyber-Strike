[resource]
script = ExtResource("1_definition")
world_id = &"emberfall_foundry"
display_name = "Emberfall Foundry"
role_description = "STELLAR HORIZON — Night. Cross a cinder yard of smelters, ore silos, crane gantries and slag pools to breach the Seam Drill core and recover the Breach Capacitor schematic."
world_scene = ExtResource("2_world")
environment_scene_path = "res://assets/forge/worlds/emberfall.glb"
field_size = Vector2(328, 204)
field_center = Vector2(42, -10)
plate_path = "res://assets/ui/world_emberfall_foundry.jpg"
status_line = "OPEN"
zone_title = "EXPLORE THE FOUNDRY"
zone_subtitle = "RECOVERY · SEAM DRILL SIGNAL"
field_ready = true
player_spawn = Vector3(0, 0.1, 10)
recovery_caches = Array[RecoveryCacheDefinition]([SubResource("Resource_seam_core"), SubResource("Resource_smelter_vault")])
