[resource]
script = ExtResource("1_definition")
world_id = &"titans"
display_name = "THE TITANS"
role_description = "STELLAR HORIZON — Storm. Fight down the storm-lashed south shelter beneath the central tower to secure the Storm Conductor schematic and search the eastern transport wreck."
world_scene = ExtResource("2_world")
environment_scene_path = "res://assets/forge/worlds/titans.glb"
field_size = Vector2(192, 192)
field_center = Vector2(0, 0)
plate_path = "res://assets/ui/world_titans.jpg"
status_line = "OPEN"
zone_title = "EXPLORE THE TITANS"
zone_subtitle = "RECOVERY · STORM SPIRE SIGNAL"
field_ready = true
player_spawn = Vector3(0, 0.1, 8)
recovery_caches = Array[RecoveryCacheDefinition]([SubResource("Resource_storm_spire"), SubResource("Resource_east_wreck")])
