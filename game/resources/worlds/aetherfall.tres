[resource]
script = ExtResource("1_definition")
world_id = &"aetherfall"
display_name = "AETHERFALL"
role_description = "SH-01 Sentinel Citadel. Advance from the western Arrival Outpost across the snow-swept central spine to bring the Horizon Relay online, breach the Sentinel Archive interior against armored robot squads, and sweep the Outpost & East Hangar caches."
world_scene = ExtResource("2_world")
environment_scene_path = "res://scenes/worlds/aetherfall_world.tscn"
field_size = Vector2(360, 320)
field_center = Vector2(0, -4)
plate_path = "res://assets/ui/world_aetherfall.jpg"
status_line = "OPEN"
zone_title = "EXPLORE AETHERFALL"
zone_subtitle = "SAFE ZONE · RELAY & ARCHIVE"
field_ready = true
player_spawn = Vector3(-30, 1.2, 9)
player_spawn_yaw_degrees = -105.0
recovery_caches = Array[RecoveryCacheDefinition]([SubResource("Resource_horizon_relay"), SubResource("Resource_archive_vault"), SubResource("Resource_primary_cache"), SubResource("Resource_hangar_cache")])
