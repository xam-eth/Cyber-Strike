[resource]
script = ExtResource("1_definition")
world_id = &"vanguard_station"
display_name = "Vanguard Station"
role_description = "Dock 07 of a dead orbital station: breach the Reactor Hall behind the pressure door to secure the Phase Thrusters schematic, or sweep the Cargo Bay for salvage telemetry."
world_scene = ExtResource("2_world")
plate_path = "res://assets/ui/world_vanguard_station.jpg"
status_line = "OPEN"
zone_title = "DOCK 07 · STATION"
zone_subtitle = "SAFE ZONE · SEALS OPEN"
field_ready = true
recovery_caches = Array[RecoveryCacheDefinition]([SubResource("Resource_reactor_core"), SubResource("Resource_cargo_manifest")])
