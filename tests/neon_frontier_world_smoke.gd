extends SceneTree
##
## neon_frontier_world_smoke.gd — the world is real, and it works in the engine.
##
## This test used to assert the *procedural* build: component scenes generated in
## GDScript, an FBX kit, a hand-built arena bay, per-route causeway nodes. None of
## that exists any more. The world is one staged GLB assembled by the asset forge,
## so what is worth asserting is different, and stricter:
##
##   1. the GLB scene is instanced under the world node,
##   2. every single MeshInstance3D in the world lives inside that GLB — nothing is
##      added by code,
##   3. the authored clips are running (one player per clip),
##   4. the lighting rig still delivers the warm-key/cool-ambient look,
##   5. the player can still walk the field on the collision layer.
##
## (2) is the in-engine version of the forge's asset-policy gate: it fails the day
## somebody adds a MeshInstance3D with a primitive mesh to the world script.
##
const MainScene = preload("res://scenes/main.tscn")


func _initialize() -> void:
	call_deferred("_run_smoke_test")


func _run_smoke_test() -> void:
	var main_scene := MainScene.instantiate()
	main_scene.set("start_wave_session_on_ready", false)
	root.add_child(main_scene)
	await process_frame
	await physics_frame
	# The GLB import is lazy on first load; give the animation players a frame to
	# register their clips before we count them.
	for _warm in 4:
		await process_frame

	var world: Node3D = main_scene.get_node("NeonFrontier")
	var player: Node3D = main_scene.get_node("Player")
	var test_passed := true

	var real_world := world.get_node_or_null("RealFrontierWorld") as Node3D
	test_passed = (
		_expect(real_world != null, "the world instances the staged real GLB scene") and test_passed
	)

	var all_meshes := world.find_children("*", "MeshInstance3D", true, false)
	var glb_meshes: Array[Node] = (
		real_world.find_children("*", "MeshInstance3D", true, false) if real_world != null else []
	)
	print(
		(
			"NEON FRONTIER real world: %d meshes (%d from the GLB)."
			% [all_meshes.size(), glb_meshes.size()]
		)
	)
	test_passed = (
		_expect(
			glb_meshes.size() >= 400,
			"the staged world GLB carries the geometry (got %d meshes)" % glb_meshes.size(),
		)
		and test_passed
	)
	test_passed = (
		_expect(
			all_meshes.size() == glb_meshes.size(),
			(
				"no mesh is generated by code outside the real GLB (%d foreign)"
				% (all_meshes.size() - glb_meshes.size())
			),
		)
		and test_passed
	)

	var clip_players := 0
	if real_world != null:
		for candidate in real_world.find_children("Clip_*", "AnimationPlayer", true, false):
			var clip_player := candidate as AnimationPlayer
			if clip_player.is_playing():
				clip_players += 1
	print("NEON FRONTIER authored motion: %d clips running." % clip_players)
	test_passed = (
		_expect(
			clip_players >= 60,
			"the world's authored clips are running (%d of 119)" % clip_players,
		)
		and test_passed
	)

	var env_node := world.get_node_or_null("ArenaEnvironment") as WorldEnvironment
	var sun := world.get_node_or_null("FrontierDaylightSun") as DirectionalLight3D
	var reactor_fill := world.get_node_or_null("ReactorCyanBounce") as OmniLight3D
	var graded := env_node != null and env_node.environment != null
	if graded:
		graded = (
			env_node.environment.tonemap_mode == Environment.TONE_MAPPER_ACES
			and env_node.environment.ambient_light_source == Environment.AMBIENT_SOURCE_COLOR
			and (
				env_node.environment.ambient_light_color.b
				>= env_node.environment.ambient_light_color.r
			)
			and env_node.environment.adjustment_saturation < 1.0
			and sun != null
			and sun.light_color.r > sun.light_color.b
			and sun.light_energy < 1.1
			and sun.shadow_enabled
			and sun.shadow_opacity >= 0.5
			and sun.shadow_opacity <= 0.65
			and reactor_fill != null
			and reactor_fill.omni_range <= 13.0
			and reactor_fill.light_energy < 0.8
		)
	test_passed = (
		_expect(graded, "lighting keeps a warm key against a cool ambient, with real shadows")
		and test_passed
	)

	for wayfinder in ["NorthRouteWayfinder", "SouthRouteWayfinder"]:
		test_passed = (
			_expect(
				world.get_node_or_null(wayfinder) != null,
				"non-visual waypoint exists: " + wayfinder,
			)
			and test_passed
		)

	var floor_collision := (
		world.get_node_or_null("ArenaFloor/ArenaFloorCollisionShape") as CollisionShape3D
	)
	var floor_shape: BoxShape3D = null
	if floor_collision != null:
		floor_shape = floor_collision.shape as BoxShape3D
	test_passed = (
		_expect(
			floor_shape != null and floor_shape.size.x >= 180.0 and floor_shape.size.z >= 170.0,
			"the collision floor covers the complete explorable world",
		)
		and test_passed
	)

	# Walk the field: the GLB is visual, the collision floor is the ground.
	player.global_position = Vector3(0.0, 0.0, 8.0)
	player.set("velocity", Vector3.ZERO)
	player.call("set_touch_movement", Vector2.UP)
	for _frame in 800:
		await physics_frame
		if player.global_position.z <= -49.0:
			break
	player.call("set_touch_movement", Vector2.ZERO)
	test_passed = (
		_expect(
			player.global_position.z <= -49.0,
			"player can walk from the arena to the boss gate on the real world floor",
		)
		and test_passed
	)
	print("Central-to-boss traversal ended at %s." % player.global_position)

	player.global_position = Vector3(-40.0, 0.0, 0.0)
	player.set("velocity", Vector3.ZERO)
	player.call("set_touch_movement", Vector2.LEFT)
	for _frame in 400:
		await physics_frame
		if player.global_position.x <= -60.0:
			break
	player.call("set_touch_movement", Vector2.ZERO)
	test_passed = (
		_expect(
			player.global_position.x <= -60.0,
			"player can cross to the outpost district",
		)
		and test_passed
	)

	main_scene.queue_free()
	await process_frame
	if test_passed:
		print(
			(
				"NEON FRONTIER 3D world smoke test passed (%d real meshes, %d clips)."
				% [glb_meshes.size(), clip_players]
			)
		)
		quit()
	else:
		quit(1)


func _expect(condition: bool, message: String) -> bool:
	if not condition:
		push_error("NEON FRONTIER world smoke test failed: " + message)
	return condition
