extends SceneTree

## Guards the rigged-hero integration.
##
## The GLB work (decimation, baked aim/fire clips, the weapon socket rotation)
## only matters if the game actually wires it up. These assertions are the
## difference between "the file has clips" and "the soldier holds the rifle":
##
##   * the player avatar really is the rigged hero (not the capsule fallback),
##   * the rifle hangs off the R_Hand bone, within a palm's width of it,
##   * the muzzle marker sits on the rifle's baked MuzzlePoint, and the flash
##     node sits on that same point,
##   * a shot leaves from that muzzle, along the barrel,
##   * aiming plays the aim clip and levels the barrel with the player's facing,
##     while the carry pose keeps it angled down.
##
## Numbers come from game/assets/characters/hero/hero_rig.json, which is
## generated by tools/gltf/build_clips.py.

const MainScene = preload("res://scenes/main.tscn")
const RIG_PATH := "res://assets/characters/hero/hero_rig.json"

var _failures: Array[String] = []


func _initialize() -> void:
	call_deferred("_run_smoke_test")


func _run_smoke_test() -> void:
	var rig := _load_rig()
	_expect(not rig.is_empty(), "hero_rig.json exists and parses")
	var main_scene := MainScene.instantiate()
	main_scene.set("start_wave_session_on_ready", false)
	main_scene.get_node("ProgressionService").set("profile_path", "")
	root.add_child(main_scene)
	await process_frame
	await process_frame
	var progression := main_scene.get_node("ProgressionService") as ProgressionService
	progression.balance = 120
	_expect(progression.unlock_weapon(&"nova_launcher"), "test unlocks Nova for the reload pose")

	var player: Node3D = main_scene.get_node("Player")
	var visual: Node3D = player.get_node("VisualRoot")
	var weapon_controller: Node = player.get_node("WeaponController")
	var socket: Node3D = player.get_node("VisualRoot/WeaponSocket")
	var muzzle: Marker3D = player.get_node("VisualRoot/WeaponSocket/Muzzle")
	var muzzle_flash: Node3D = player.get_node_or_null("VisualRoot/WeaponSocket/MuzzleFlash")
	var weapon: Node3D = player.get_node_or_null("VisualRoot/WeaponSocket/WeaponModel")

	# --- the avatar is the rigged hero -------------------------------------
	_expect(
		bool(visual.call("is_rigged")),
		"the player avatar is a rigged skeleton with an AnimationPlayer"
	)
	var anim_player := _find_anim_player(visual)
	_expect(anim_player != null, "the hero model carries an AnimationPlayer")
	var clips: PackedStringArray = (
		anim_player.get_animation_list() if anim_player != null else PackedStringArray()
	)
	for clip in [
		"idle", "run", "walk", "aim", "aim_walk", "aim_run", "fire", "reload", "hit", "death"
	]:
		_expect(clips.has(clip), "Blender-authored hero.glb provides the '%s' clip" % clip)
	for clip in ["walk", "run", "aim_walk", "aim_run"]:
		if anim_player != null and anim_player.has_animation(clip):
			_expect(
				anim_player.get_animation(clip).loop_mode == Animation.LOOP_LINEAR,
				"moving '%s' loops rather than freezing after one cycle" % clip,
			)
	for clip in ["fire", "reload", "hit", "death"]:
		if anim_player != null and anim_player.has_animation(clip):
			_expect(
				anim_player.get_animation(clip).loop_mode == Animation.LOOP_NONE,
				"one-shot '%s' does not loop" % clip,
			)

	# --- the rifle is in the hand ------------------------------------------
	var skeleton := _find_skeleton(visual)
	_expect(skeleton != null, "the hero model carries a Skeleton3D")
	var hand_bone := str(rig.get("hand_bone", "R_Hand"))
	var hand_index := skeleton.find_bone(hand_bone) if skeleton != null else -1
	_expect(hand_index >= 0, "the skeleton has the '%s' bone" % hand_bone)
	_expect(weapon != null, "the rifle GLB is attached under the weapon socket")
	if skeleton == null or hand_index < 0 or weapon == null:
		_finish(main_scene)
		return

	var hand_position := (
		skeleton.global_transform * skeleton.get_bone_global_pose(hand_index).origin
	)
	var hand_distance := socket.global_position.distance_to(hand_position)
	_expect(
		hand_distance < 0.25,
		"the weapon socket rides the hand bone (%.3f m from it)" % hand_distance,
	)
	var head_index := skeleton.find_bone("Head")
	var hip_index := skeleton.find_bone("Hip")
	var left_foot_index := skeleton.find_bone("L_Foot")
	var right_foot_index := skeleton.find_bone("R_Foot")
	var has_collapse_bones := (
		head_index >= 0 and hip_index >= 0 and left_foot_index >= 0 and right_foot_index >= 0
	)
	_expect(has_collapse_bones, "the Blender death pose has head, hip, and both foot bones")
	var idle_head_height := 0.0
	var idle_foot_height := 0.0
	var idle_left_foot := Vector3.ZERO
	if has_collapse_bones:
		idle_head_height = _bone_world(skeleton, head_index).y
		idle_left_foot = _bone_world(skeleton, left_foot_index)
		idle_foot_height = minf(
			idle_left_foot.y,
			_bone_world(skeleton, right_foot_index).y,
		)

	# --- the muzzle is the barrel's own point ------------------------------
	var muzzle_point := weapon.get_node_or_null("MuzzlePoint") as Node3D
	_expect(muzzle_point != null, "the rifle GLB carries a baked MuzzlePoint node")
	if muzzle_point != null:
		var error := muzzle.global_position.distance_to(muzzle_point.global_position)
		_expect(error < 0.002, "the Muzzle marker sits on MuzzlePoint (%.4f m error)" % error)
		var local_muzzle := weapon.transform.affine_inverse() * muzzle.transform
		_expect(
			local_muzzle.origin.z < -0.3,
			"the muzzle sits at the barrel end (local z %.2f)" % local_muzzle.origin.z,
		)
	if muzzle_flash != null:
		var flash_error := muzzle_flash.global_position.distance_to(muzzle.global_position)
		_expect(flash_error < 0.002, "the flash node is on the muzzle (%.4f m error)" % flash_error)
	else:
		_expect(false, "the muzzle flash node is still in the tree")

	# --- carry pose ---------------------------------------------------------
	var forward := -player.global_transform.basis.z.normalized()
	var carry_barrel := _barrel(muzzle)
	var carry_socket_z := socket.global_transform.basis.z.normalized()
	_expect(
		carry_barrel.dot(forward) < 0.92,
		"the lowered rifle is angled down in the carry pose (dot %.2f)" % carry_barrel.dot(forward),
	)

	# --- aiming -------------------------------------------------------------
	# The controller re-applies its own aim state every physics tick, so drive
	# both sides and stop the physics loop for the duration of the check.
	player.set_physics_process(false)
	player.call("set_aiming", true)
	visual.call("set_aiming", true)
	visual.call("update_pose", Vector3.ZERO, true, 0.016)
	for _frame in 30:
		await process_frame
	_expect(str(visual.call("current_clip")) == "aim", "aiming plays the aim clip")
	var aim_barrel := _barrel(muzzle)
	_expect(
		aim_barrel.dot(forward) > 0.95,
		"the aimed barrel points where the player faces (dot %.2f)" % aim_barrel.dot(forward),
	)
	var aim_changed := absf(socket.global_transform.basis.z.normalized().dot(carry_socket_z))
	_expect(
		aim_changed < 0.92, "the rifle changes angle between carry and aim (dot %.2f)" % aim_changed
	)
	visual.call("update_pose", Vector3(2.5, 0.0, 0.0), true, 0.016)
	visual.call("_process", 0.016)
	_expect(
		str(visual.call("current_clip")) == "aim_walk",
		"moving aim blends walking legs with aimed upper body instead of sliding",
	)
	if anim_player != null:
		for _tick in range(6):
			anim_player.advance(0.04)
		anim_player.seek(0.4, true)
		anim_player.advance(0.01)
	visual.call("_process", 0.3)
	_expect(
		_barrel(muzzle).dot(forward) > 0.96,
		"aim-walk keeps the barrel level at mid-stride",
	)
	if has_collapse_bones:
		var walk_stride := _bone_world(skeleton, left_foot_index).distance_to(idle_left_foot)
		_expect(
			walk_stride > 0.25,
			(
				"aim-walk moves a real boot bone, not just the AnimationPlayer label (%.2f m)"
				% walk_stride
			),
		)
	visual.call("update_pose", Vector3(6.0, 0.0, 0.0), true, 0.016)
	visual.call("_process", 0.016)
	_expect(str(visual.call("current_clip")) == "aim_run", "sprint aim has a moving-leg clip")
	if anim_player != null:
		for _tick in range(6):
			anim_player.advance(0.04)
		anim_player.seek(0.3, true)
		anim_player.advance(0.01)
	visual.call("_process", 0.3)
	_expect(
		_barrel(muzzle).dot(forward) > 0.96,
		"aim-run does not tip the barrel away from the reticle at mid-stride",
	)
	if has_collapse_bones:
		var run_stride := _bone_world(skeleton, left_foot_index).distance_to(idle_left_foot)
		_expect(
			run_stride > 0.28,
			"aim-run drives the Blender sprint legs in the game (%.2f m from idle)" % run_stride,
		)
	visual.call("update_pose", Vector3.ZERO, true, 0.016)
	visual.call("_process", 0.016)
	_expect(str(visual.call("current_clip")) == "aim", "stopping returns to stationary aim")

	# --- a shot leaves from the barrel -------------------------------------
	var children_before := main_scene.get_child_count()
	var target := muzzle.global_position + aim_barrel * 20.0
	var fired: bool = bool(weapon_controller.call("try_fire", player, muzzle, target))
	_expect(fired, "the weapon fires from the rigged muzzle")
	if fired:
		var spawned: Node3D = null
		for index in range(children_before, main_scene.get_child_count()):
			var child := main_scene.get_child(index) as Node3D
			if child != null:
				spawned = child
		_expect(spawned != null, "the shot spawns a projectile")
		if spawned != null:
			var spawn_error := spawned.global_position.distance_to(muzzle.global_position)
			_expect(
				spawn_error < 0.05,
				"the projectile starts at the barrel (%.3f m from the muzzle)" % spawn_error,
			)
	if muzzle_flash != null:
		# effects_smoke proves the controller triggers *a* flash on a real shot;
		# this proves the node that gets triggered lives at the barrel mouth.
		muzzle_flash.call("flash", 1.0)
		_expect(bool(muzzle_flash.call("is_flashing")), "the flash at the barrel can be triggered")
		await process_frame
	visual.call("play_recoil", 1.0)
	_expect(str(visual.call("current_clip")) == "fire", "the recoil swaps to the fire clip")
	# Tick the visual by hand: headless frames are far shorter than the 0.45 s
	# fire clip, so waiting for real time would take thousands of iterations.
	visual.call("_process", 0.5)
	_expect(str(visual.call("current_clip")) == "aim", "the fire clip returns to the aim pose")

	var requested_reload: bool = bool(weapon_controller.call("request_reload"))
	_expect(requested_reload, "spent magazine can start a measured reload")
	_expect(
		str(visual.call("current_clip")) == "reload",
		"the real ammo reload signal starts the Blender handling action",
	)
	weapon_controller.call("_process", 0.5)
	var remaining: float = float(weapon_controller.call("current_reload_remaining"))
	_expect(remaining > 0.0 and remaining < 1.35, "ammo timer advances during reload")
	weapon_controller.call("select_weapon", 1)
	_expect(str(visual.call("current_clip")) == "aim", "changing weapons hides the old reload")
	weapon_controller.call("select_weapon", 0)
	_expect(str(visual.call("current_clip")) == "reload", "switching back resumes a live reload")
	_expect(
		is_equal_approx(float(visual.get("_reload_remaining")), remaining),
		"reload pose only lasts as long as the remaining ammo timer",
	)
	weapon_controller.call("reset_ammo")
	_expect(str(visual.call("current_clip")) == "aim", "refilled magazine ends the reload action")
	player.call("apply_damage", 8.0)
	_expect(str(visual.call("current_clip")) == "hit", "nonfatal damage plays hit reaction")
	visual.call("_process", 0.6)
	# The visual's action timer was advanced by hand. Give AnimationPlayer the
	# same simulated time, too: otherwise the test piles fire→reload→hit→aim
	# blends into a few milliseconds before inspecting death. Real gameplay
	# advances both on every frame; an impossible mixer backlog is not QA.
	if anim_player != null:
		anim_player.advance(0.6)
	_expect(str(visual.call("current_clip")) == "aim", "hit reaction returns to aimed stance")
	player.call("apply_damage", 1000.0)
	_expect(str(visual.call("current_clip")) == "death", "fatal damage plays death motion")
	# Headless timer wall time is not game time: a 0.14-second wait advanced
	# fewer than 0.05 animation seconds under software rendering. The opt-in
	# real Web build measures the running mixer clock and head-bone height.
	visual.call("_process", 1.6)
	_expect(str(visual.call("current_clip")) == "death", "death pose remains until reset")
	if has_collapse_bones and anim_player != null:
		# Simulate 1.2 seconds of actual mixer frames, *not* seek(1.2) while
		# aim→death is still crossfading. Seeking before a blend completes can
		# move the clip clock without advancing the old pose's fade-out weight.
		for _tick in range(30):
			anim_player.advance(0.04)
		skeleton.force_update_all_bone_transforms()
		var fallen_hip := _bone_world(skeleton, hip_index)
		var fallen_head := _bone_world(skeleton, head_index)
		var fallen_foot_height := minf(
			_bone_world(skeleton, left_foot_index).y,
			_bone_world(skeleton, right_foot_index).y,
		)
		var head_spread := (
			Vector2(fallen_head.x - fallen_hip.x, fallen_head.z - fallen_hip.z).length()
		)
		var sideways := head_spread > 0.35 and fallen_head.y < idle_head_height - 0.55
		var clip_before_trace := anim_player.current_animation
		var time_before_trace := anim_player.current_animation_position
		# Direct playback is a *diagnostic*, never a shortcut that makes the
		# actual gameplay-driven death sample pass this assertion.
		var trace := _death_trace(anim_player, skeleton) if not sideways else ""
		_expect(
			sideways,
			(
				(
					"death lies sideways: spread %.2f m, head %s, hip %s, idle head y %.2f,"
					+ " player clip %s @ %.2f/%.2f s; %s"
				)
				% [
					head_spread,
					fallen_head,
					fallen_hip,
					idle_head_height,
					clip_before_trace,
					time_before_trace,
					anim_player.get_animation("death").length,
					trace,
				]
			),
		)
		_expect(
			fallen_foot_height > idle_foot_height - 0.16,
			(
				"the death clip keeps both boots clear of the deck (%.2f m vs %.2f m idle)"
				% [fallen_foot_height, idle_foot_height]
			),
		)
	player.call("reset_player")
	_expect(str(visual.call("current_clip")) == "idle", "reset exits death into neutral idle")

	# In a real browser screenshot the FIRST hip shot originated near the boot:
	# recoil did shoulder the rifle, but only after the projectile had already
	# left. Prime the existing Blender pose before resolving the first shot.
	visual.call("prime_shot_pose")
	_expect(str(visual.call("current_clip")) == "aim", "hip shot primes the authored aim pose")
	# Resetting death changes the clip name before its blended pose has fully
	# settled, so its immediate 'carry' y can be stale. Compare to the body's
	# actual ground origin instead: the bad WebGL shot was 0.54 m above it.
	var muzzle_height := muzzle.global_position.y - player.global_position.y
	_expect(
		muzzle_height > 1.0,
		"first hip shot puts the real barrel above the boot before firing (%.2f m)" % muzzle_height,
	)
	_expect(
		_barrel(muzzle).dot(forward) > 0.94,
		"first hip shot aligns the real rifle barrel before the projectile leaves",
	)
	_expect(
		muzzle.global_position.distance_to(muzzle_point.global_position) < 0.002,
		"first hip shot still comes from the GLB's measured MuzzlePoint",
	)
	visual.call("play_recoil", 1.0)
	_expect(
		str(visual.call("current_clip")) == "fire", "hip-fire shoulders the rifle and plays recoil"
	)
	visual.call("_process", 0.22)
	if anim_player != null:
		anim_player.advance(0.22)
	_expect(
		_barrel(muzzle).dot(forward) > 0.94,
		"hip-fire turns the actual barrel toward the reticle rather than leaving it in carry",
	)
	visual.call("_process", 0.5)
	if anim_player != null:
		anim_player.advance(0.5)
	_expect(str(visual.call("current_clip")) == "idle", "hip-fire returns to carry after the burst")
	visual.call("update_pose", Vector3(6.0, 0.0, 0.0), true, 0.016)
	visual.call("prime_shot_pose")
	_expect(
		str(visual.call("current_clip")) == "aim_run" and _barrel(muzzle).dot(forward) > 0.94,
		"moving hip shot uses authored aim-run legs with the barrel forward before firing",
	)
	visual.call("play_recoil", 1.0)
	_expect(
		str(visual.call("current_clip")) == "aim_run",
		"sprint hip-fire uses the Blender aim-run stride instead of frozen standing legs",
	)
	visual.call("_process", 0.22)
	if anim_player != null:
		anim_player.advance(0.22)
	_expect(
		_barrel(muzzle).dot(forward) > 0.94,
		"sprint hip-fire keeps the measured barrel pointed forward",
	)
	visual.call("_process", 0.5)
	_expect(str(visual.call("current_clip")) == "run", "sprint hip-fire returns to run on release")

	_finish(main_scene)


func _barrel(muzzle: Node3D) -> Vector3:
	return -muzzle.global_transform.basis.z.normalized()


func _bone_world(skeleton: Skeleton3D, index: int) -> Vector3:
	return skeleton.global_transform * skeleton.get_bone_global_pose(index).origin


func _death_trace(player: AnimationPlayer, skeleton: Skeleton3D) -> String:
	# If a baked GLB visibly moves in the glTF viewer but the Godot skeleton
	# remains upright, show the imported track and mixer root in the CI failure.
	var clip := player.get_animation("death")
	var root_index := skeleton.find_bone("BoneRoot")
	var track := "none"
	for index in range(clip.get_track_count()):
		var path := str(clip.track_get_path(index))
		if path.contains("BoneRoot") and clip.track_get_type(index) == Animation.TYPE_ROTATION_3D:
			var last := clip.track_get_key_count(index) - 1
			track = (
				"%s enabled=%s keys=%d last=%s"
				% [
					path,
					clip.track_is_enabled(index),
					last + 1,
					clip.track_get_key_value(index, last)
				]
			)
			break
	var pose_rotation := (
		skeleton.get_bone_pose_rotation(root_index) if root_index >= 0 else Quaternion.IDENTITY
	)
	var anchor := player.get_node_or_null(player.root_node)
	var track_target := anchor.get_node_or_null("Armature/Skeleton3D") if anchor != null else null
	# Directly sample without crossfade: this separates an active blend from an
	# import/track-binding problem. Diagnostic only, immediately before reset.
	player.stop()
	player.play("death", 0.0)
	player.seek(1.2, true)
	player.advance(0.001)
	skeleton.force_update_all_bone_transforms()
	var forced_rotation := (
		skeleton.get_bone_pose_rotation(root_index) if root_index >= 0 else Quaternion.IDENTITY
	)
	return (
		(
			"mixer=%s root=%s same=%s active=%s root_motion=%s tracks=%d "
			+ "BoneRoot before=%s forced=%s track=%s"
		)
		% [
			player.get_path(),
			player.root_node,
			track_target == skeleton,
			player.active,
			player.root_motion_track,
			clip.get_track_count(),
			pose_rotation,
			forced_rotation,
			track,
		]
	)


func _finish(main_scene: Node) -> void:
	main_scene.queue_free()
	await process_frame
	if _failures.is_empty():
		print("Hero rig smoke test passed.")
		quit()
	else:
		print("Hero rig smoke test failed: %d problem(s)." % _failures.size())
		for failure in _failures:
			print("  - " + failure)
		quit(1)


func _load_rig() -> Dictionary:
	if not FileAccess.file_exists(RIG_PATH):
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(RIG_PATH))
	if parsed is Dictionary:
		return parsed
	return {}


func _find_skeleton(root_node: Node) -> Skeleton3D:
	var found := root_node.find_children("*", "Skeleton3D", true, false)
	return found[0] as Skeleton3D if not found.is_empty() else null


func _find_anim_player(root_node: Node) -> AnimationPlayer:
	var found := root_node.find_children("*", "AnimationPlayer", true, false)
	return found[0] as AnimationPlayer if not found.is_empty() else null


func _expect(condition: bool, message: String) -> bool:
	if condition:
		print("  ok: " + message)
	else:
		_failures.append(message)
		push_error("Hero rig smoke test failed: " + message)
	return condition
