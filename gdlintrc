# Procedural world and component builders are intentionally organized by district/asset.
# Keep a hard limit while allowing those two detailed geometry scripts to remain cohesive.
# main.gd is the game composition root (recovery state machine, HUD wiring, session
# transitions); it carries the mission flow that no other module owns.
max-file-lines: 1700
# MenuStage is the shared base for every front-end screen: metrics, labels,
# buttons, margins. Its public surface is the layout vocabulary the screens
# share, so the default cap of 20 is one short of the vocabulary rather than a
# sign of a god object.
max-public-methods: 24
