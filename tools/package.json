{
  "name": "cyber-strike-tools",
  "private": true,
  "type": "module",
  "description": "Browser QA for the WebAssembly preview (Chromium is a pinned package, never assumed to be installed).",
  "scripts": {
    "qa": "node web_qa.mjs",
    "qa:json": "node web_qa.mjs --json",
    "qa:loading": "node web_loading_qa.mjs --throughput-mbps 100 --json",
    "qa:support": "node web_support_qa.mjs --json"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "puppeteer-core": "24.31.0",
    "three": "^0.170.0"
  },
  "dependencies": {
    "gltf-validator": "^2.0.0-dev.3.10"
  }
}
